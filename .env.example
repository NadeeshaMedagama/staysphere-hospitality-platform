###############################################################################
# StaySphere — local environment template
#
#   cp .env.example .env
#
# Every value here is a development placeholder. Nothing in this file is a real
# secret, and nothing in .env is ever committed (see .gitignore).
###############################################################################

# ---------------------------------------------------------------- runtime ----
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_VERSION=0.0.0-dev

# --------------------------------------------------------------- databases ---
# Neon gives every service its own database. In Neon, create one project per
# service (or one project with a branch per service) and copy both strings:
#
#   DATABASE_URL  → the *pooled* endpoint (…-pooler.…), used at runtime
#   DIRECT_URL    → the *direct* endpoint, used by Prisma Migrate
#
# Prisma Migrate cannot run through PgBouncer — it needs advisory locks that the
# pooler does not forward. Using the pooled URL for migrations fails at the
# first DDL statement.
AUTH_DATABASE_URL=postgresql://staysphere:staysphere_dev_password@localhost:5432/staysphere_auth
AUTH_DIRECT_URL=postgresql://staysphere:staysphere_dev_password@localhost:5432/staysphere_auth

BOOKING_DATABASE_URL=postgresql://staysphere:staysphere_dev_password@localhost:5432/staysphere_booking
BOOKING_DIRECT_URL=postgresql://staysphere:staysphere_dev_password@localhost:5432/staysphere_booking

# Each service reads DATABASE_URL / DIRECT_URL; the compose file maps the
# per-service values above onto them.
DATABASE_URL=${AUTH_DATABASE_URL}
DIRECT_URL=${AUTH_DIRECT_URL}
DATABASE_POOL_SIZE=10

# ---- Host ports for the local stack ----
# Override any that collide with something already running on your machine.
# A native Postgres on 5432 is the usual culprit: it wins the bind, and every
# service then talks to the wrong database with a confusing access error.
# POSTGRES_PORT=55432
# REDIS_PORT=6380
# KAFKA_PORT=9093

# ------------------------------------------------------------------ cache ----
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------ kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=staysphere-local
KAFKA_SSL=false
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ------------------------------------------------------------------- auth ----
# Generate real values with:  openssl rand -base64 48
# These MUST be at least 32 characters, and MUST differ from each other.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production-32
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production-32
JWT_ISSUER=staysphere.auth
JWT_AUDIENCE=staysphere.api

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# -------------------------------------------------------------- gateway ------
# Any upstream left unset makes the gateway answer UPSTREAM_UNAVAILABLE for that
# route rather than failing to start — so a partial local stack still works.
AUTH_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
HOTEL_SERVICE_URL=http://localhost:3003
ROOM_SERVICE_URL=http://localhost:3004
PRICING_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
STAY_SERVICE_URL=http://localhost:3007
FINANCE_SERVICE_URL=http://localhost:3008
HOUSEKEEPING_SERVICE_URL=http://localhost:3009
MAINTENANCE_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
REVIEW_SERVICE_URL=http://localhost:3012
REPORTING_SERVICE_URL=http://localhost:3013
AUDIT_SERVICE_URL=http://localhost:3014

UPSTREAM_TIMEOUT_MS=10000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=30000

# ---------------------------------------------------------------- http --------
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
REQUEST_TIMEOUT_MS=15000

# ------------------------------------------------------------- booking -------
MAX_STAY_NIGHTS=90
BOOKING_HOLD_MINUTES=20
DEFAULT_CURRENCY=USD

# ------------------------------------------------------------ front ends -----
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_APP_VERSION=0.0.0-dev
# How long a front end waits on the gateway before giving up. The default suits
# a deployment sitting next to its database; raise it in apps/*/.env.local when
# developing against a database in another region.
NEXT_PUBLIC_GATEWAY_TIMEOUT_MS=12000

# --------------------------------------------------------- observability -----
METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
