  "private": true,
  "description": "The StaySphere design system: tokens and React components shared by the guest site, the operations console and the staff app.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tokens.css"
