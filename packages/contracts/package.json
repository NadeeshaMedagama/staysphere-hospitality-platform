{
  "name": "@staysphere/contracts",
  "version": "1.0.0",
  "description": "Shared domain enums, HTTP envelopes, error codes and versioned domain-event contracts for the StaySphere platform.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.mjs",
      "require": "./dist/domain/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.mjs",
      "require": "./dist/errors/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.mjs",
      "require": "./dist/http/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NadeeshaMedagama/StaySphere.git",
    "directory": "packages/contracts"
  },
  "keywords": [
    "staysphere",
    "hotel",
    "contracts",
    "domain-events",
    "microservices"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@staysphere/eslint-config": "workspace:*",
    "@staysphere/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "module": "./dist/index.mjs"
}
