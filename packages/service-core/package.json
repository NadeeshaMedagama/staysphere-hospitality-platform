{
  "name": "@staysphere/service-core",
  "version": "1.0.0",
  "description": "Shared NestJS runtime for StaySphere services: config, structured logging, request context, error envelope, health probes, metrics, Kafka transport, idempotency and resilience.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NadeeshaMedagama/StaySphere.git",
    "directory": "packages/service-core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@staysphere/contracts": "workspace:*",
    "nanoid": "^3.3.20",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/testing": "^10.4.22",
    "@staysphere/eslint-config": "workspace:*",
    "@staysphere/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
