{
  "name": "@staysphere/api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Single ingress for the StaySphere platform: routing, authentication, rate limiting, resilience and health aggregation.",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e .env -- nest start --watch",
    "start": "node dist/main.js",
    "clean": "rimraf dist .turbo coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^10.4.22",
    "@staysphere/contracts": "workspace:*",
    "@staysphere/service-core": "workspace:*",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "kafkajs": "^2.2.4",
    "nanoid": "^3.3.20",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@staysphere/eslint-config": "workspace:*",
    "@staysphere/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
